# Public URL, used for OG Image when running nuxt generate
NUXT_PUBLIC_SITE_URL=

# The origin this deployment serves from. Required for anything that verifies a
# forge-account attestation, which includes enabling chat: the server trusts
# attestations from this origin and no other, so with it unset every attestation
# is rejected.
#
# It must match the `attestedBy` on the space.maintainers.forgeAccount record,
# which is the origin that signed it (the request origin at link time, NOT this
# variable). An account linked on 127.0.0.1:3000 therefore won't verify against a
# deployment configured for maintainers.space, and vice versa. Reconnect the
# account to re-mint it against the origin you're running.
#   http://127.0.0.1:3000        (development)
#   https://maintainers.space    (production)
NUXT_PUBLIC_APP_URL=

# GitHub OAuth (server-side, required for verified account linking + notifications).
# Create an OAuth App at https://github.com/settings/developers with the callback:
#   http://127.0.0.1:3000/api/auth/github/callback           (development)
#   https://maintainers.space/api/auth/github/callback       (production)
NUXT_GITHUB_CLIENT_ID=
NUXT_GITHUB_CLIENT_SECRET=

# GitLab OAuth (server-side, required for verified account linking + notifications).
# Create an Application at https://gitlab.com/-/user_settings/applications with:
#   scope: api   redirect URI:
#   http://127.0.0.1:3000/api/auth/gitlab/callback           (development)
#   https://maintainers.space/api/auth/gitlab/callback       (production)
NUXT_GITLAB_CLIENT_ID=
NUXT_GITLAB_CLIENT_SECRET=

# Codeberg OAuth (server-side, required for verified account linking + notifications).
# Codeberg runs Forgejo; create an application at https://codeberg.org/user/settings/applications
# with the redirect URI:
#   http://127.0.0.1:3000/api/auth/codeberg/callback           (development)
#   https://maintainers.space/api/auth/codeberg/callback       (production)
# Forgejo OAuth2 tokens are unscoped (full user access), so no scope is requested.
NUXT_CODEBERG_CLIENT_ID=
NUXT_CODEBERG_CLIENT_SECRET=

# Gitea OAuth (server-side, required for verified account linking + notifications).
# Gitea's own hosted instance at https://gitea.com — create an OAuth2 application
# at https://gitea.com/user/settings/applications with the redirect URI:
#   http://127.0.0.1:3000/api/auth/gitea/callback           (development)
#   https://maintainers.space/api/auth/gitea/callback       (production)
NUXT_GITEA_CLIENT_ID=
NUXT_GITEA_CLIENT_SECRET=

# Bitbucket Cloud OAuth (server-side, required for verified account linking).
# Create an OAuth clients under a workspace's Settings -> OAuth clients at
# https://bitbucket.org/<workspace>/workspace/settings/oauth-clients with the
# callback URL:
#   http://127.0.0.1:3000/api/auth/bitbucket/callback           (development)
#   https://maintainers.space/api/auth/bitbucket/callback       (production)
# Bitbucket has no native issue tracker integration here (Atlassian is removing
# it) and no notifications/activity-feed/follow-graph API at all — this is a
# real platform limitation, not a missing feature.
NUXT_BITBUCKET_CLIENT_ID=
NUXT_BITBUCKET_CLIENT_SECRET=

# Forge-account attestation signing key (server-side, optional but recommended).
# A private ES256 (P-256) key in JWK JSON form. maintainers.space signs a verifiable proof
# that a linked forge account belongs to your atproto DID, so the "Verified" badge
# on public profiles cannot be forged by editing the PDS record. Without it,
# linking still works but shows no verified badge.
# Generate one with:
#   node -e "import('jose').then(async j => { const {publicKey, privateKey} = await j.generateKeyPair('ES256', {extractable:true}); const jwk = await j.exportJWK(privateKey); jwk.kid = (await j.calculateJwkThumbprint(await j.exportJWK(publicKey))); jwk.alg='ES256'; jwk.use='sig'; console.log(JSON.stringify(jwk)); })"
NUXT_ATTESTATION_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Chat (Colibri)
# ---------------------------------------------------------------------------
# The Chat tab embeds @colibri-social/client against a Colibri AppView. Reading
# an existing chat needs only the AppView. Creating one also needs a PDS this
# server can mint community accounts on.

# The Colibri AppView's canonical identity. Its did:web (host with ':'
# percent-encoded) is the audience baked into every Colibri OAuth permission set
# and service-auth token, so this one value drives the scope in
# /client-metadata.json, the `aud` in app/lib/chat/colibri.ts, and mountColibri's
# appViewUrl.
#
# This must be a host the *PDS* can resolve, so do NOT point it at a local
# AppView. A PDS silently drops every `include:` scope whose `aud` it cannot
# resolve and grants the rest, so a loopback value costs you exactly the five
# Colibri permission sets, and the only symptom is chat reporting that it needs
# permissions you just approved. Use NUXT_PUBLIC_COLIBRI_APPVIEW_DIAL_URL below
# to develop against a local AppView.
#   https://api.colibri.social       (default)
NUXT_PUBLIC_COLIBRI_APPVIEW_URL=

# Where AppView traffic is actually sent, when that differs from the identity
# above. Leave empty in production. Note that under `pnpm dev`
# @colibri-social/client redirects its own traffic to http://127.0.0.1:8000
# regardless (it branches on import.meta.env.DEV), so this only redirects the
# XRPC calls this app makes itself, i.e. creating a community and its channels.
#   http://127.0.0.1:8000            (local AppView)
NUXT_PUBLIC_COLIBRI_APPVIEW_DIAL_URL=

# The PDS that hosts community accounts, used only by "Create a chat". Needs its
# own port, since 3000 is the dev server itself.
NUXT_CHAT_PDS_LOC=

# Admin password for that PDS (server-only, never exposed to the client). Used to
# mint an invite code and a fresh account per community. Without it, "Create a
# chat" returns 503. Linking an existing community still works.
NUXT_CHAT_PDS_ADMIN_PASS=

# Handle domain for minted community accounts, e.g. `test` for a local PDS.
NUXT_CHAT_APPVIEW_HANDLE_DOMAIN=
