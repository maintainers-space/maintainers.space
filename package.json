{
  "name": "maintainers.space",
  "version": "0.1.0",
  "private": true,
  "description": "Unified forges interaction website",
  "homepage": "https://maintainers.space",
  "bugs": {
    "url": "https://github.com/maintainers-space/maintainers.space/issues"
  },
  "license": "MIT",
  "author": "trueberryless <trueberryless@gmail.com> (https://felixs.dev)",
  "repository": {
    "type": "git",
    "url": "https://github.com/maintainers-space/maintainers.space.git"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "typecheck": "nuxt typecheck",
    "knip": "knip",
    "audit": "pnpm audit --audit-level moderate",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "check:quick": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test:coverage",
    "check:push": "pnpm run check:quick && pnpm run knip && pnpm run audit && pnpm run test:e2e",
    "release:version": "node scripts/version-release.mjs",
    "review:ai": "coderabbit review --light --uncommitted",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:lighthouse": "lhci autorun"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.3",
    "@atcute/client": "^5.1.1",
    "@atcute/identity-resolver": "^2.0.1",
    "@atcute/lexicons": "^2.0.3",
    "@atcute/oauth-browser-client": "^4.0.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/simple-icons": "^1.2.92",
    "@internationalized/date": "^3.12.2",
    "@nuxt/ui": "^4.10.0",
    "@vueuse/nuxt": "^14.4.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.13",
    "force-graph": "^1.51.4",
    "h3": "^1.15.11",
    "jose": "^6.2.4",
    "marked": "^18.0.7",
    "nuxt": "^4.5.1",
    "tailwindcss": "^4.3.3",
    "unicode-emoji-json": "^0.9.0",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@changesets/changelog-github": "1.0.0",
    "@changesets/cli": "3.0.1",
    "@lhci/cli": "^0.15.1",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/typography": "^0.5.20",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.1",
    "knip": "^6.29.0",
    "nano-staged": "^1.0.2",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.76.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vitest-environment-nuxt": "^2.0.0",
    "vue-tsc": "^3.3.8"
  },
  "simple-git-hooks": {
    "commit-msg": "node scripts/check-commit-message.mjs \"$1\"",
    "pre-commit": "pnpm exec nano-staged",
    "pre-push": "pnpm run check:push"
  },
  "nano-staged": {
    "*.{ts,vue,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,yml,yaml,css}": "oxfmt"
  },
  "packageManager": "pnpm@11.13.1"
}
