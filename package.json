{
  "name": "maintainers.space",
  "private": true,
  "description": "Unified forges interaction website",
  "homepage": "https://maintainers.space",
  "bugs": {
    "url": "https://github.com/maintainers-space/maintainers.space/issues"
  },
  "license": "MIT",
  "author": "trueberryless <trueberryless@gmail.com> (https://felixs.dev)",
  "repository": {
    "type": "git",
    "url": "https://github.com/maintainers-space/maintainers.space.git"
  },
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare && simple-git-hooks",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "typecheck": "nuxt typecheck",
    "knip": "knip"
  },
  "dependencies": {
    "@atcute/atproto": "^4.0.3",
    "@atcute/client": "^5.1.1",
    "@atcute/identity-resolver": "^2.0.1",
    "@atcute/lexicons": "^2.0.3",
    "@atcute/oauth-browser-client": "^4.0.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@iconify-json/lucide": "^1.2.120",
    "@iconify-json/simple-icons": "^1.2.92",
    "@internationalized/date": "^3.12.2",
    "@nuxt/ui": "^4.10.0",
    "@vueuse/nuxt": "^14.4.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.12",
    "force-graph": "^1.51.4",
    "h3": "^1.15.11",
    "jose": "^6.2.4",
    "marked": "^18.0.7",
    "nuxt": "^4.5.1",
    "tailwindcss": "^4.3.3",
    "unicode-emoji-json": "^0.9.0",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "knip": "^6.29.0",
    "lint-staged": "^17.2.0",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.76.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.8"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{json,md,yml,yaml,css}": "oxfmt"
  },
  "packageManager": "pnpm@11.13.1"
}
